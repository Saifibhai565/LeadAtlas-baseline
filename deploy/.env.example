# ===== Copy this file to .env and fill it in =====

# Your domain (DNS "A" record must point to this server's IP)
DOMAIN=leadatlas.example.com
# Email for the free SSL certificate notices
ACME_EMAIL=you@example.com

# Long random strings. Make them with:  openssl rand -hex 32
AUTH_SECRET=
CRON_SECRET=

# The email that becomes the platform admin when it signs up (you)
ADMIN_EMAIL=you@example.com

# Shown in the app; changing these needs a rebuild (docker compose up -d --build)
APP_NAME=LeadAtlas
DEFAULT_COUNTRY_CODE=92

# Free credits for new signups (can also be changed in Admin > Settings)
SIGNUP_CREDITS=100

# Optional: AI features
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Optional: proxies for the scraper if Google blocks the server's IP
# ENGINE_PROXIES=http://user:pass@host:port

ENRICH_CONCURRENCY=4
AI_DAILY_LIMIT=400

# Emails
APP_URL=https://leadatlas.example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=LeadAtlas <no-reply@leadatlas.example.com>
ADMIN_ALERT_EMAIL=

# Card payments (optional)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
# White-label target that agencies point their CNAME to (usually your DOMAIN)
WHITELABEL_TARGET=

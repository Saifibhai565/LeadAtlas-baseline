# Database (SQLite for local development - koi installation nahi chahiye)
DATABASE_URL="file:./dev.db"

# Login cookies ko sign karne ke liye lambi random string. Zaroor badlein!
AUTH_SECRET="change-this-to-a-long-random-string-at-least-32-chars"

# Go scraping engine ka address (go run main.go yahin chalta hai)
ENGINE_URL="http://localhost:8080"

# App ka naam (sidebar aur title mein nazar aata hai)
NEXT_PUBLIC_APP_NAME="LeadAtlas"

# WhatsApp links ke liye default country code (0 se shuru hone wale numbers par lagta hai)
NEXT_PUBLIC_DEFAULT_COUNTRY_CODE="92"

# Naye user ko signup par kitne free credits milenge (1 credit = 1 lead)
SIGNUP_CREDITS="500"

# --- Phase 3 ---
# Web extractor (AI). Key: https://console.anthropic.com  (khaali chhorein to extractor band rahega)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-5-5"

# Website checks: ek waqt mein kitni websites check hon
ENRICH_CONCURRENCY="4"

# --- Phase 6 ---
# Server par har 5 minute /api/cron?secret=... call karein taake watches app band hone par bhi chalein
CRON_SECRET="change-this-too"

# --- Phase 8 ---
# Har account ke roz ke AI actions ki had (kharcha qaboo mein rakhne ke liye)
AI_DAILY_LIMIT="400"

# --- Phase 10: Emails (SMTP) ---
# App ka poora address, emails ke links ke liye (live par: https://aapka-domain.com)
APP_URL="http://localhost:3000"
# SMTP: Brevo, Zoho, Resend, Amazon SES, ya apne domain ki email. Khaali chhorein to emails terminal mein print hongi
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="LeadAtlas <no-reply@example.com>"
# Nayi payment ka alert kis email par aaye (khaali = ADMIN_EMAIL)
ADMIN_ALERT_EMAIL=""

# --- Phase 13 ---
# Card payments (international) with Lemon Squeezy. Khaali = band. Har plan ka "variant id" Admin > Plans mein
LEMONSQUEEZY_API_KEY=""
LEMONSQUEEZY_STORE_ID=""
LEMONSQUEEZY_WEBHOOK_SECRET=""
# White-label: aapke server ka IP ya main domain, jis par agencies apna domain point karengi (CNAME)
WHITELABEL_TARGET="app.example.com"

# --- Phase 16 ---
# Meta Graph API version for WhatsApp Business and Instagram
WHATSAPP_API_VERSION="v21.0"

# --- Phase 40 ---
# Lead price and deposits are set in Super Admin > Settings; deposit methods in Super Admin > Payment methods (crypto/bank)
